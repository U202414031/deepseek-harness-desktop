{
  "name": "dsh-desktop-im-bridge",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "In-app IM gateway (QQ / 飞书 / 微信) for DeepSeek Harness Desktop — bridges phone-side chat to the local agent.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.5.10",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
